# Configuración para WhatsApp Bot - Termux Edition
# Copia este archivo como .env y ajusta los valores según necesites

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=error

# Ruta personalizada para la base de datos (opcional)
# Por defecto se usa ~/bot_data.sqlite en Termux
DB_PATH=./bot_data.sqlite

# Puerto para el dashboard web
PORT=3000

# Tu API key de Gemini AI (opcional)
# Obtén una en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Configuraciones adicionales para Termux
# Estas se configuran automáticamente, pero puedes sobrescribirlas

# Directorio home personalizado (no recomendado cambiar)
# TERMUX_HOME=/data/data/com.termux/files/home

# Directorio temporal personalizado (no recomendado cambiar)  
# TMPDIR=/data/data/com.termux/files/usr/tmp
